# Set automatically by `bunx convex dev` after selecting your development project.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Set TWITCH_CLIENT_ID and TWITCH_CLIENT_SECRET in the Convex deployment's
# Environment Variables dashboard, not in Next.js or NEXT_PUBLIC_* variables.
# Collection starts automatically every minute once both values are set.

# Clerk: Next.js only (never commit real keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set these on the Convex deployment, not just this file:
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# CLERK_ADMIN_USER_IDS=user_your_admin_id
